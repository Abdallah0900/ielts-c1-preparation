  "entries": [
    {"id": "grammar-c1-001", "topic": "conditionals", "subtopic": "third", "classification": "CORE_FOR_IELTS_7_PLUS", "cefr": "B2", "structure": "If + past perfect, would have + past participle", "meaning": "Unreal past condition", "example": "If governments had invested in renewable energy earlier, the climate crisis would have been less severe.", "ielts_relevance": {"writing": "high", "speaking": "high"}, "common_errors": ["double_would"]},
    {"id": "grammar-c1-002", "topic": "conditionals", "subtopic": "mixed", "classification": "USEFUL_FOR_IELTS_7_8", "cefr": "C1", "structure": "If + past perfect, would + infinitive", "meaning": "Past condition, present result", "example": "If I had studied medicine, I would be a doctor now.", "ielts_relevance": {"writing": "medium", "speaking": "high"}, "common_errors": ["tense_mismatch"]},
    {"id": "grammar-c1-003", "topic": "passive", "subtopic": "impersonal", "classification": "CORE_FOR_IELTS_7_PLUS", "cefr": "B2", "structure": "It + passive + that + clause", "meaning": "Impersonal reporting", "example": "It is widely believed that education is the key to economic development.", "ielts_relevance": {"writing": "high", "speaking": "medium"}, "common_errors": ["active_passive_confusion"]},
